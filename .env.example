# Nivaari Founding 100 Research Environment Configuration
# Copy this file to .env.local for local development with live Supabase.

# 1. Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Anonymous Client Public Key (safe for client-side use with RLS enabled)
# NEVER put the service_role key here.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

